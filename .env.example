# Production: Supabase Connect > Transaction pooler (port 6543).
# Store the real connection string as a secret; never commit it.
# DATABASE_URL=postgresql://postgres.PROJECT:PASSWORD@POOLER_HOST:6543/postgres
TRUST_PROXY=1
# APP_ORIGIN=https://your-site.vercel.app
# RESEND_API_KEY=
# MAIL_FROM=
# Local development uses SQLite automatically when DATABASE_URL is absent.
