# Local development works without any environment variables: npm start
# Vercel production: connect a persistent Turso database (never a local file).
TURSO_DATABASE_URL=libsql://your-database.turso.io
TURSO_AUTH_TOKEN=
# Set your exact HTTPS production origin, with no trailing slash.
APP_ORIGIN=https://your-project.vercel.app
# Vercel has one trusted proxy. Leave unset when running locally.
TRUST_PROXY=1
# Optional: password reset email delivery via a verified Resend sender.
RESEND_API_KEY=
MAIL_FROM=PACE <hello@your-verified-domain.com>
